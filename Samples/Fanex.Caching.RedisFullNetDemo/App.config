<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <section name="Fanex.Caching" type="Fanex.Caching.Configuration.CacheSettings, Fanex.Caching" />
    </configSections>
    <Fanex.Caching cacheType="Fanex.Caching.Redis.RedisCache, Fanex.Caching.Redis">
        <connectionSettings>
            <add name="Host" value="127.0.0.1" />
            <add name="Port" value="6379" />
            <add name="ApplicationName" value="Fanex.Caching.RedisFullNetDemo" />
        </connectionSettings>
    </Fanex.Caching>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
</configuration>