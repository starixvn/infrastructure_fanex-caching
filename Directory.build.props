<Project>
    <PropertyGroup>
        <Authors>R&amp;D Team</Authors>
        <Company>Nexcel Solutions</Company>
        <Copyright>2018 Nexdev</Copyright>
        <PackageProjectUrl>https://gitlab.nexcel.vn/infrastructure/fanex-caching</PackageProjectUrl>
        <RepositoryUrl>https://gitlab.nexcel.vn/infrastructure/fanex-caching</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>https://gitlab.nexcel.vn/infrastructure/fanex-caching/milestones/1</PackageReleaseNotes>
        <PackageIconUrl>https://gitlab.nexcel.vn/uploads/-/system/project/avatar/696/new-idea.png</PackageIconUrl>
        <DefaultLanguage>en-US</DefaultLanguage>
        <IncludeSymbols>false</IncludeSymbols>
        <Version>2.2.0-beta1</Version>
    </PropertyGroup>
    <PropertyGroup>
        <NoWarn>AD0001,SA1302</NoWarn>
        <Features>IOperation</Features>
        <CodeAnalysisRuleSet>$(SolutionDir)\Fanex.Caching.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="SonarAnalyzer.CSharp" Version="7.2.0.5463">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="StyleCop.Analyzers" Version="1.0.2">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
        <Reference Include="System.Core" Pack="false" />
    </ItemGroup>
</Project>