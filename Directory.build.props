<Project>
    <PropertyGroup>
        <Authors>R&amp;D Team</Authors>
        <PackageProjectUrl>https://gitlab.nexdev.net/infrastructure/fanex-caching</PackageProjectUrl>
        <RepositoryUrl>https://gitlab.nexdev.net/infrastructure/fanex-caching</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>https://gitlab.nexdev.net/infrastructure/fanex-caching/milestones/1</PackageReleaseNotes>
        <PackageIconUrl>https://gitlab.nexdev.net/uploads/-/system/project/avatar/696/new-idea.png</PackageIconUrl>
        <DefaultLanguage>en-US</DefaultLanguage>
        <LangVersion>latest</LangVersion>
        <IncludeSymbols>false</IncludeSymbols>
        <Version>2.2.1</Version>
    </PropertyGroup>
    <PropertyGroup>
        <NoWarn>AD0001,S1192,SA1302</NoWarn>
        <Features>IOperation</Features>
        <CodeAnalysisRuleSet>$(SolutionDir)\.sonarlint\Fanex.CachingCSharp.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="SonarAnalyzer.CSharp" Version="7.11.0.8083">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="StyleCop.Analyzers" Version="1.1.1-rc.114">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
        <Reference Include="System.Core" Pack="false" />
    </ItemGroup>
</Project>