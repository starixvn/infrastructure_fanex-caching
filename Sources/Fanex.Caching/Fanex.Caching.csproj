<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net461;netstandard1.6</TargetFrameworks>
        <Version>2.2.0</Version>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <Description>New version of Fanex.Caching which supports many target frameworks and asynchronous APIs.</Description>
        <PackageTags>fanex.caching; memory</PackageTags>
    </PropertyGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
        <Reference Include="System" />
        <Reference Include="System.Configuration" />
        <Reference Include="Microsoft.CSharp" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard1.6'">
        <PackageReference Include="System.Collections.NonGeneric" Version="4.3.0" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="Content\app.config.transform" />
        <Content Include="Content\web.config.transform" />
    </ItemGroup>
</Project>