<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>New storage of Fanex.Caching which is REDIS.</Description>
        <PackageTags>fanex.caching; redis</PackageTags>
        <TargetFrameworks>net471;netstandard2.0;net7.0</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="MessagePack" Version="2.5.124" />
        <PackageReference Include="StackExchange.Redis" Version="2.6.122" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net471'">
        <PackageReference Include="System.ValueTuple" Version="4.5.0" />
        <PackageReference Include="System.Memory" Version="4.5.5" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Fanex.Caching\Fanex.Caching.csproj" />
    </ItemGroup>
</Project>