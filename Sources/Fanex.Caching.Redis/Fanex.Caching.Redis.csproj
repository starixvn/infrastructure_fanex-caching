<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net5.0;net8.0</TargetFrameworks>
    <LangVersion>13.0</LangVersion>
    <Description>New storage of Fanex.Caching which is REDIS.</Description>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Version>2.2.5</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <Title>Fanex.Caching.Redis</Title>
    <Copyright>NexDev</Copyright>
    <PackageProjectUrl>https://gitlab.nexdev.net/infrastructure/fanex-caching</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.nexdev.net/infrastructure/fanex-caching</RepositoryUrl>
    <PackageTags>fanex.caching; redis</PackageTags>
  </PropertyGroup>
 
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="2.5.192" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <PackageReference Include="System.Memory" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fanex.Caching\Fanex.Caching.csproj" />
  </ItemGroup>
  
</Project>