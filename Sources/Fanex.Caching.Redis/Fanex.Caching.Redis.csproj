        <PackageTags>fanex.caching; redis</PackageTags>
        <TargetFrameworks>net461;netstandard2.0</TargetFrameworks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="MessagePack" Version="2.4.35" />
