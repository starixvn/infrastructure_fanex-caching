<?xml version="1.0" encoding="utf-8" ?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <configSections>
        <section name="Fanex.Caching" type="Fanex.Caching.Configuration.CacheSettings, Fanex.Caching" xdt:Transform="Remove"/>
    </configSections>
    <Fanex.Caching cacheType="Fanex.Caching.Redis.RedisCache, Fanex.Caching.Redis" xdt:Transform="Remove">
